#!/bin/sh

# Keep the shared launcher checkout as an exact mirror of origin/bojan.
# Completed work belongs on a dedicated worktree branch and reaches bojan
# through scripts/push-bojan.js.

set -e

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "$branch" = "bojan" ]; then
	echo "pre-commit: direct commits on bojan are blocked." >&2
	echo "pre-commit: commit from a dedicated worktree branch, then run node scripts/push-bojan.js." >&2
	exit 1
fi

exit 0
